{
  "manifest_version": 2,
  "name": "Read For Me",
  "version": "0.1.0",
  "description": "Detects terms/policies/leases and summarizes key points and concerns with Gemini.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://generativelanguage.googleapis.com/*"
  ],
  "browser_action": {
    "default_title": "Read For Me",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
